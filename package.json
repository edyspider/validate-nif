{
  "name": "@edyspider/validate-nif",
  "version": "2.0.0",
  "description": "A package to validate Portuguese fiscal identification numbers (NIF)",
  "type": "module",
  "main": "./src/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edyspider/validate-nif.git"
  },
  "keywords": [
    "NIF",
    "VAT",
    "Validate",
    "Portugal",
    "TypeScript"
  ],
  "author": "EdySpider",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edyspider/validate-nif/issues"
  },
  "homepage": "https://github.com/edyspider/validate-nif#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
